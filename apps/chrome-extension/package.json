{
  "name": "@fut-copilot/chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wxt build --browser chrome",
    "dev": "wxt --browser chrome",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@fut-copilot/domain": "workspace:*",
    "@fut-copilot/ea-web-adapter": "workspace:*",
    "@fut-copilot/storage": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "5.9.3",
    "wxt": "0.21.3"
  }
}
