{
  "name": "fut-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first, personal EA SPORTS FC Ultimate Team browser copilot.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @fut-copilot/chrome-extension build",
    "dev": "pnpm --filter @fut-copilot/chrome-extension dev",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "verify:fixtures": "node scripts/verify-fixture-redaction.mjs",
    "verify:permissions": "node scripts/verify-permissions.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm verify:fixtures && pnpm build && pnpm verify:permissions"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
